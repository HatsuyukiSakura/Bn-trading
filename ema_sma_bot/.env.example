# 複製為 repo 根目錄的 .env 後填入（.env 已在 .gitignore，切勿提交）
# API 權限只開「讀取」與「合約」，不要開提幣；綁定 IP 白名單；使用機器人專用子帳戶
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = 測試網 demo-fapi.binance.com（金鑰需在 Futures Demo Trading 另外申請）
BINANCE_TESTNET=true
# true = 只記錄將下的單，不送出（仍需 API key 讀取帳戶）
DRY_RUN=false

SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,BNBUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,LTCUSDT
EMA_PERIOD=150
# ema = 收盤 > EMA150 做多、< EMA150 出場（研究報告的規則）；ema_sma = 加上 SMA150 濾網
SIGNAL_MODE=ema
SMA_PERIOD=150

# 交易所端槓桿只當保證金緩衝；實際有效槓桿由 MAX_GROSS_EXPOSURE 控制（≤ 1.0）
EXCHANGE_LEVERAGE=2
MARGIN_TYPE=CROSSED
MAX_GROSS_EXPOSURE=1.0
REBAL_BAND=0.25

# 盤中停損：進場均價下方 10% 掛 STOP_MARKET（以標記價觸發）；0 = 關閉
STOP_LOSS_PCT=0.10
STOP_WORKING_TYPE=MARK_PRICE

# 風控
KILL_SWITCH_DD=0.45
DAILY_LOSS_PAUSE=0.20
MAX_MARK_DEVIATION=0.02

KLINE_LIMIT=1000
CLOSE_DELAY_SEC=20
RECONCILE_EVERY_SEC=300
DB_PATH=state.db

# 選用：Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
