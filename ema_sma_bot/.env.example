# 複製為 .env 後填入（切勿將 .env 提交到 git）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# spot = 現貨（只做多）；futures = USDⓈ-M 永續合約（可做空）
MARKET=spot
# true = 測試網；確認無誤後再改 false 使用正式網
BINANCE_TESTNET=true
# true = 只記錄訊號與將下的單，不真正下單
DRY_RUN=true

SYMBOL=BTCUSDT
INTERVAL=4h
EMA_PERIOD=150
SMA_PERIOD=150

# 每次進場使用可用 USDT 的比例
POSITION_PCT=0.95
# 僅 futures：是否允許做空、槓桿倍數
ALLOW_SHORT=false
LEVERAGE=1

KLINE_LIMIT=1000
CLOSE_DELAY_SEC=5
STATE_FILE=ema_sma_bot_state.json

# 選用：Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
